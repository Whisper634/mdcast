# 复制本文件为 .env，或 export 到环境变量。全部可选：不配 LLM 也能跑规则版。
MDCAST_API_KEY=
MDCAST_BASE_URL=https://api.moonshot.cn/v1
MDCAST_MODEL=kimi-k2.6
# MDCAST_TEMPERATURE=1.0
# MDCAST_LLM_TIMEOUT=180

# 小红书卡片自定义文案（不配用默认值）：
# MDCAST_CARD_KICKER=读书笔记
# MDCAST_CARD_END_TITLE=你在想什么？
# MDCAST_CARD_END_SUB=评论区聊聊你的看法
# MDCAST_CARD_FOOTER=关注我看更多「你的账号名」

# 自定义红线词表路径（默认用包内示例词表，务必换成自己的）：
# MDCAST_GUARD_WORDS=guard_words.txt
